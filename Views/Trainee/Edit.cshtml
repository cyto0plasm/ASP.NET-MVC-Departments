@model ATwo.Models.Trainee

<div class="container py-4" style="max-width: 500px;">

    <div class="d-flex align-items-center mb-4">
        <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h4 class="mb-0 fw-semibold">Edit Trainee</h4>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Trainee", FormMethod.Post,
                        new { enctype = "multipart/form-data" }))
            {
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 mb-3" })
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Image) @* keeps old image path if no new file is chosen *@

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, "Name", new { @class = "form-label fw-medium" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Full name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Image</label>

                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div class="mb-2">
                            <img src="@Model.Image" alt="Current"
                                 style="height:80px; width:80px; object-fit:cover; border-radius:8px;" />
                            <small class="text-muted ms-2">Current image</small>
                        </div>
                    }

                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Leave empty to keep current image.</small>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Address, "Address", new { @class = "form-label fw-medium" })
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Address" })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Grade, "Grade", new { @class = "form-label fw-medium" })
                    @Html.TextBoxFor(m => m.Grade, new { @class = "form-control", placeholder = "0.0" })
                    @Html.ValidationMessageFor(m => m.Grade, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.DepartmentId, "Department", new { @class = "form-label fw-medium" })
                    @Html.DropDownListFor(m => m.DepartmentId,
                        new SelectList(ViewBag.Departments, "Id", "Name"),
                        "— Select department —",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.DepartmentId, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Save</button>
                    <a href="@Url.Action("Details", new { id = Model.Id })"
                       class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}