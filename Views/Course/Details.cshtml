@model ATwo.Models.Course

<div class="container py-4" style="max-width: 700px;">

    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h4 class="mb-0 fw-semibold">@Model.Name</h4>
    </div>

    @* Basic Info *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body px-4 py-3">
            <dl class="row mb-0">
                <dt class="col-sm-4">Department</dt>
                <dd class="col-sm-8 text-muted">@(Model.Department?.Name ?? "—")</dd>

                <dt class="col-sm-4">Degree</dt>
                <dd class="col-sm-8 text-muted">@(Model.Degree?.ToString() ?? "—")</dd>

                <dt class="col-sm-4">Min Degree</dt>
                <dd class="col-sm-8 text-muted">@(Model.MinDegree?.ToString() ?? "—")</dd>

                <dt class="col-sm-4">Hours</dt>
                <dd class="col-sm-8 text-muted">@(Model.Hrs?.ToString() ?? "—")</dd>
            </dl>
        </div>
    </div>

    @* Instructors *@
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white fw-medium py-2 px-4">Instructors</div>
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Salary</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Instructors != null && Model.Instructors.Any())
                {
                    @foreach (var ins in Model.Instructors)
                    {
                        <tr>
                            <td class="ps-4">@ins.Name</td>
                            <td class="text-muted">@(ins.Salary?.ToString() ?? "—")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-3">No instructors.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Course Results *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-medium py-2 px-4">Course Results</div>
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Trainee</th>
                    <th>Degree</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.CourseResults != null && Model.CourseResults.Any())
                {
                    @foreach (var result in Model.CourseResults)
                    {
                        <tr>
                            <td class="ps-4">@(result.Trainee?.Name ?? "—")</td>
                            <td class="text-muted">@(result.Degree?.ToString() ?? "—")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-3">No results.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
    </div>
</div>