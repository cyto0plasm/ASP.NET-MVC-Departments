@model List<ATwo.Models.Instructor>

<div class="container py-4" style="max-width: 800px;">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="mb-0 fw-semibold">Instructors</h4>
        <div class="input-group" style="max-width: 280px;">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-muted"></i>
            </span>
                <input id="searchInput"
                       type="text"
                       class="form-control border-start-0 ps-0"
                       placeholder="Search by name..." />
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Name</th>
                    <th>Department</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="instructorTable">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 fw-medium instructor-name">@item.Name</td>
                        <td class="text-muted">@(item.Department?.Name ?? "—")</td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary px-3">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="noResults" class="text-center text-muted py-4 d-none">
            No instructors match your search.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const input = document.getElementById('searchInput');
        const rows = document.querySelectorAll('#instructorTable tr');
        const noResults = document.getElementById('noResults');

        input.addEventListener('input', () => {
            const query = input.value.toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.querySelector('.instructor-name')?.textContent.toLowerCase() ?? '';
                const match = name.includes(query);
                row.classList.toggle('d-none', !match);
                if (match) visibleCount++;
            });

            noResults.classList.toggle('d-none', visibleCount > 0);
        });
    </script>
}