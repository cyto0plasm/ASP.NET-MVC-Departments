@model ATwo.Models.Department

<div class="container py-4" style="max-width: 500px;">

    <div class="d-flex align-items-center mb-4">
        <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h4 class="mb-0 fw-semibold">New Department</h4>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @using (Html.BeginForm("Create", "Department", FormMethod.Post))
            {
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, "Name", new { @class = "form-label fw-medium" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Department name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Manager, "Manager", new { @class = "form-label fw-medium" })
                    @Html.TextBoxFor(m => m.Manager, new { @class = "form-control", placeholder = "Manager name" })
                    @Html.ValidationMessageFor(m => m.Manager, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Create</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}